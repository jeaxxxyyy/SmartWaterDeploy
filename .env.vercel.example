APP_NAME="SmartWater"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-PROJECT.vercel.app
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=YOUR_ONLINE_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=smartwater
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_WEB_TOKEN_MINUTES=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

CRON_SECRET=

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@YOUR_DOMAIN
MAIL_FROM_NAME="SmartWater"

DEVICE_ACTIVATION_MINUTES=15
DEVICE_TOKEN_DAYS=90
DEVICE_OFFLINE_SECONDS=15
