APP_NAME="Smart Water Monitoring"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smart-water-deploy.vercel.app
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_PORT=5432
# Copy Neon's direct connection string for migrations. Use the pooled URL in Vercel.
DB_URL="postgresql://ROLE:PASSWORD@YOUR_DIRECT_NEON_HOST:5432/neondb?sslmode=require"
DB_SSLMODE=require
DB_CHARSET=utf8

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_WEB_TOKEN_MINUTES=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

CRON_SECRET=

# Switch to a verified SMTP provider before relying on password recovery emails.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Smart Water Monitoring"

DEVICE_ACTIVATION_MINUTES=15
DEVICE_TOKEN_DAYS=90
DEVICE_OFFLINE_SECONDS=15
